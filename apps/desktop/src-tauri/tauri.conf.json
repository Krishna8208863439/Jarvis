{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/cli/schema.json",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "http://localhost:3000",
    "distDir": "../../apps/web/.next"
  },
  "package": {
    "productName": "NOVA",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "fs": {
        "all": false,
        "readFile": true,
        "writeFile": true,
        "readDir": true,
        "scope": ["$DESKTOP/*", "$DOCUMENT/*"]
      },
      "shell": {
        "all": false,
        "open": true,
        "execute": false
      },
      "window": {
        "all": true
      }
    },
    "bundle": {
      "active": false,
      "identifier": "com.nova.assistant"
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "PROJECT NOVA - Universal AI Assistant",
        "width": 1280,
        "height": 840,
        "resizable": true,
        "fullscreen": false,
        "transparent": false
      }
    ]
  }
}

